# Supabase: Project Settings -> API
SUPABASE_URL=https://your-project-ref.supabase.co
SUPABASE_SERVICE_ROLE_KEY=

# Supabase: Connect -> Connection string -> URI (Session pooler), with your DB password filled in
DATABASE_URL=postgresql://postgres.your-project-ref:PASSWORD@aws-0-ap-southeast-1.pooler.supabase.com:5432/postgres

# Telegram: token from @BotFather
TELEGRAM_BOT_TOKEN=

# polling (local dev) | webhook (deployed) | off (no bot, e.g. locally while the deployed bot is live)
BOT_MODE=polling
# webhook mode only: the backend's public URL and a random secret (python -c "import secrets; print(secrets.token_urlsafe(32))")
PUBLIC_URL=
WEBHOOK_SECRET=

# Public web app URL for "Open map" buttons / Telegram Mini App (https only).
# Optional: defaults to the first https FRONTEND_ORIGIN. Locally, use a cloudflared tunnel URL.
WEB_URL=

# Allowed web origins, comma-separated
FRONTEND_ORIGIN=http://localhost:5173

# Tier 2 only
ANTHROPIC_API_KEY=

# scripts/demo.py only (stage helper): the live bot's token and your own Telegram chat id
PROD_TELEGRAM_BOT_TOKEN=
DEMO_CHAT_ID=

# Telegram chat ids (comma-separated) allowed to use /demo, the on-stage role switch
DEMO_ADMIN_CHAT_ID=
